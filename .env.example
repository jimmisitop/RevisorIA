# BOB_API_KEY: API key used by IBM Bob Shell CLI ('bob run')
BOB_API_KEY="MY_BOB_API_KEY"

# GITHUB_TOKEN: Optional GitHub Personal Access Token to access private repos and avoid rate limits
GITHUB_TOKEN="MY_GITHUB_TOKEN"

# VITE_API_URL: Backend URL used by the client development proxy
VITE_API_URL="http://localhost:3000"
